// 座標圧縮
template <typename T>
struct Compress{
  vector<T> xs;
  // デフォルトコンストラクタ（1つずつ add() して build() する場合用）
  Compress() = default;
  // コンストラクタ（配列から一気に構築する場合用、内部で自動的に build される）
  Compress(const vector<T>& a) {xs = a; build();}
  // 値の追加（必ず build() を呼ぶ前に行う）
  void add(T x){xs.push_back(x);}
  // 構築：配列のソートと重複削除を実行（get や size を呼ぶ前に必ず1回実行する）
  void build(){
    sort(xs.begin(), xs.end());
    xs.erase(unique(xs.begin(), xs.end()), xs.end());
  }
  // 元の値 x から圧縮後の 0-index を取得 (O(log N))
  int get(T x) const{
    return lower_bound(xs.begin(), xs.end(), x) - xs.begin();
  }
  // 圧縮後の 0-index i から元の値を取得 (O(1))
  T inv(int i) const{return xs[i];}
  // 圧縮後の要素数（種類数）を取得（セグメント木やBITのサイズ確保に使うと便利）
  int size() const{return xs.size();}
};

